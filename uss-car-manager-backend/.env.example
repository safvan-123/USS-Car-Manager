NODE_ENV=development
PORT=5000
# Use a separate TEST database first. Requires MongoDB Atlas or a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/uss_car_manager_test?replicaSet=rs0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://uss-car-manager.vercel.app
# Set to 1 ONLY when your host has exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Used only by npm run create-user. Remove password after user creation.
CREATE_USER_NAME=Admin
CREATE_USER_EMAIL=admin@example.com
CREATE_USER_PASSWORD=
CREATE_USER_ROLE=admin
